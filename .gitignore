# Scratch / temp
TEMP/
*.tmp
*.log

# Onboarding: INSTALL/install.md + setup.md are tracked source - init copies them
# into a target and they ship in the repo clone. Ignore only the runtime artifacts
# (the fetched engine, with INSTALL.log caught by *.log above). graduate removes INSTALL/.
INSTALL/engine/

# Setup migration archive: keep the empty folder for reference, ignore captured contents (transient, deleted after review)
AIDOCS/*_SETUP_ARCHIVE/*
!AIDOCS/*_SETUP_ARCHIVE/.gitkeep

# Environment docs: keep the folder, ignore contents (may hold secrets / setup notes - local-only)
AIDOCS/ENV/*
!AIDOCS/ENV/.gitkeep

# Staging files (transient, written by the engine, cleared on commit). Keep the folder.
AIDOCS/tools/staging/*
!AIDOCS/tools/staging/.gitkeep

# Persistent script state (machine-local). Auto-bootstrapped on first run.
AIDOCS/tools/state.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Node (if tooling grows)
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# Secrets
.env
.env.local
.env.*.local

# Local MCP server config (machine-local paths / IDs / tokens, written by Claude Code or external MCP tooling). Never commit.
.mcp.json
.claude/settings.local.json

# Session handoff scratch (local-only between sessions)
WDDOCS/SESSION_HANDOFF.md
WDDOCS/SESSION_HANDOFF_EXTENDED.md

# Local-only maintainer deploy runbook for the install site (machine paths, account-specific). Never commit.
WDDOCS/RELEASES/STD_PAGE_DEPLOY.md

# Build artifacts (none yet, reserved)
dist/
out/
build/
